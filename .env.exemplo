# Variáveis de ambiente do painel. Nenhuma é segredo.
#
# Este painel não fala com banco nenhum: lê parquet local e pronto. O modelo
# herdado do painel nacional trazia a conexão com o `cenarios_ai` por VPN —
# saiu porque não se aplica, e porque um modelo que pede senha convida a
# preenchê-la num arquivo versionado. `tests/test_segredos.py` continua de
# guarda para o caso de alguém acrescentar uma.
#
# Para desenvolvimento local, nada disto precisa ser definido: os padrões
# apontam para `data/` na raiz do projeto e para o pack de tuberculose.

# Raiz dos dados. Padrão: `data/` no projeto (`/app/data` na imagem).
SINAN_DATA_DIR=

# Pack de doença. Só `tuberculose` existe hoje.
SINAN_DOENCA=tuberculose

# Subcaminho da URL, sem barras. Vazio serve na raiz. Só importa na imagem.
BASE_URL_PATH=
